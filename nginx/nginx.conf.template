worker_processes auto;
pid /tmp/can-sentinel-nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    sendfile on;
    keepalive_timeout 65;
    client_body_temp_path /tmp/can-sentinel-nginx/body;
    proxy_temp_path /tmp/can-sentinel-nginx/proxy;
    fastcgi_temp_path /tmp/can-sentinel-nginx/fastcgi;
    uwsgi_temp_path /tmp/can-sentinel-nginx/uwsgi;
    scgi_temp_path /tmp/can-sentinel-nginx/scgi;

    server {
        listen ${PORT};
        server_name _;
        client_max_body_size 210m;

        location = /manus-routes.json {
            alias ${APP_DIR}/public/manus-routes.json;
            default_type application/json;
            add_header Cache-Control "no-cache";
        }

        location = /_stcore/health {
            proxy_pass http://127.0.0.1:8502/_stcore/health;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location / {
            proxy_pass http://127.0.0.1:8502;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
            proxy_read_timeout 86400s;
        }
    }
}
